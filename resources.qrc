<RCC>
    <qresource prefix="/qml">
        <file alias="Main.qml">qml/Main.qml</file>
        <file alias="AboutPage.qml">qml/AboutPage.qml</file>
        <file alias="NavTile.qml">qml/NavTile.qml</file>
        <file alias="NoticeBanner.qml">qml/NoticeBanner.qml</file>
    </qresource>
    <qresource prefix="/images">
        <file alias="app.svg">assets/plasma-addon-manager-icon-v2.svg</file>
        <file alias="app.png">assets/plasma-addon-manager-icon-256.png</file>
        <file alias="nav-dashboard.png">assets/nav-dashboard.png</file>
        <file alias="nav-addons.png">assets/nav-addons.png</file>
        <file alias="nav-automation.png">assets/nav-automation.png</file>
        <file alias="nav-journal.png">assets/nav-journal.png</file>
        <file alias="nav-about.png">assets/nav-about.png</file>
        <file alias="nav-notifications.png">assets/nav-notifications.png</file>
        <file alias="ui-success.png">assets/ui-success.png</file>
        <file alias="ui-warning.png">assets/ui-warning.png</file>
        <file alias="ui-error.png">assets/ui-error.png</file>
        <file alias="ui-refresh.png">assets/ui-refresh.png</file>
        <file alias="ui-clear.png">assets/ui-clear.png</file>
    </qresource>
</RCC>
